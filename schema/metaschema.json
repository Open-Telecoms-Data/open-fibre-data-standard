{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://json-schema-extension.readthedocs.io/1__1__0/2020-12/metaschema.json",
  "title": "Open Fibre Extended Meta-Schema",
  "allOf": [
    {
      "$ref": "https://json-schema.org/draft/2020-12/schema"
    }
  ],
  "properties": {
    "deprecatedDetails": {
      "title": "Deprecated details",
      "type": "object",
      "additionalProperties": false,
      "required": ["deprecatedVersion", "description"],
      "properties": {
        "deprecatedVersion": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "codelist": {
      "title": "Codelist",
      "type": "string"
    },
    "openCodelist": {
      "title": "Open codelist",
      "type": "boolean",
      "default": false,
      "deprecated": true
    },
    "x-references": {
      "title": "References",
      "description": "The JSON Pointer of the property that this field references.",
      "type": "string",
      "format": "uri-reference"
    }
  },
  "unevaluatedProperties": false
}